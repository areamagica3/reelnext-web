# Copia este archivo a .env y rellénalo. Nunca subas .env a git.
PORT=4100
# URL pública con HTTPS, sin barra final. Ej: https://reelnext.io
BASE_URL=https://reelnext.io
# Credenciales de la app en TikTok for Developers (Production)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Dos secretos largos aleatorios: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_KEY=
# Carpeta donde se guarda la base de datos y los videos temporales
DATA_DIR=./data
